# ContextFlow environment template. Copy to `.env.local`; never commit real values.

# Leave true (or unset) for the credential-free demo path with in-memory data.
# Set to false to enable Supabase authentication and persistent repositories.
# If Supabase is not fully configured below, the app stays in demo mode.
DEMO_MODE=true

# Optional. Server-only. Enables the real Claude provider instead of the
# deterministic mock. Requires DEMO_MODE=false.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Required when DEMO_MODE=false. The anon key is browser-safe and relies on
# row-level security for tenant scoping.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security. Used by the scheduled Inngest
# functions, which have no user session; never construct it on a request path.
SUPABASE_SERVICE_ROLE_KEY=

# Required to serve the scheduled brief workflow. Without a signing key the
# /api/inngest endpoint refuses to execute unsigned invocations.
# For local development against the Inngest dev server, set INNGEST_DEV=1
# instead of supplying these.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
